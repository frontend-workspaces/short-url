{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://portal.blly.to",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "blly.to"
        }
      ]
    }
  ]
}
